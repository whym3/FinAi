# Copy to server/.env. Never commit the real file.
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
APP_SECRET_KEY=
DATABASE_URL=postgresql+psycopg://pravah:pravah@localhost:5432/pravah
PUBLIC_URL=http://localhost:5173
STORAGE_DIR=./storage

# Gmail: Google Cloud OAuth client (Web application). Redirect URI: http://localhost:5173/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outlook: Azure app registration. Redirect URI: http://localhost:5173/api/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional fallbacks; keys entered in Settings → AI extraction take precedence.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
POLL_SECONDS=60
