# Copy to server/.env. Never commit the real file.
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
APP_SECRET_KEY=
DATABASE_URL=postgresql+psycopg://pravah:pravah@localhost:5432/pravah
PUBLIC_URL=http://localhost:5173
STORAGE_DIR=./storage

# Document reading. Set the provider, key and model in Settings → Integrations instead;
# this key is only the fallback used when nothing is saved there.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Two-step sign-in with an authenticator app. Off for now; turn on before real client data.
REQUIRE_MFA=false

# Outgoing email for invites and password resets (optional; without it the admin copies links).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pravah <no-reply@example.com>

# Gmail: Google Cloud OAuth client (Web application). Redirect URI: <PUBLIC_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outlook: Azure app registration. Redirect URI: <PUBLIC_URL>/api/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=

POLL_SECONDS=60
